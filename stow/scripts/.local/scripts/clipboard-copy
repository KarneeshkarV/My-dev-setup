#!/usr/bin/env bash
# clipboard-copy: OSC 52 clipboard copy for tmux and Ghostty over SSH.
buf=$(cat)
b64=$(printf '%s' "$buf" | base64 | tr -d '\n')

# copy-pipe-and-cancel does not make stdout the pane's PTY, so write the
# passthrough sequence directly to the pane terminal when running in tmux.
if [ -n "$TMUX" ]; then
    pane_tty=$(tmux display-message -p '#{pane_tty}')
    printf '\033Ptmux;\033\033]52;c;%s\007\033\\' "$b64" > "$pane_tty"
elif [ -w /dev/tty ]; then
    printf '\033]52;c;%s\007' "$b64" > /dev/tty
else
    printf '\033]52;c;%s\007' "$b64"
fi
